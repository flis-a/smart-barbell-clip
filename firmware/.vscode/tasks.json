{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure (MB1293)",
      "type": "shell",
      "command": "cmake -S . -B build -G Ninja -DBOARD=MB1293 -DCMAKE_BUILD_TYPE=Debug",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --build build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash (OpenOCD)",
      "type": "shell",
      "command": "openocd -f interface/stlink.cfg -f target/stm32wbx.cfg -c 'program build/smart-barbell-clip-fw.elf verify reset exit'",
      "dependsOn": "Build",
      "problemMatcher": []
    }
  ]
}
