# ===== General OS / editor noise (3.5.1) =====
.DS_Store
Thumbs.db
*.log
*.swp

# VS Code: ignore everything except the few opt-in shared files.
# extensions.json recommends extensions to future-you; tasks.json and
# launch.json are useful to share once you've stripped absolute paths.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# ===== Firmware build artifacts (3.5.2) =====
firmware/build/
cmake-build-*/
*.o
*.elf
*.bin
*.hex
*.map
*.lst

# ===== React Native artifacts (3.5.3) =====
node_modules/
app/ios/Pods/
app/ios/build/
app/android/local.properties
app/android/.gradle/
app/android/build/
app/android/app/build/
.env
.env.local
.env.*.local

# ===== KiCAD (3.5.4) =====
*-backups/
fp-info-cache
_autosave-*
hardware/**/fab/

# ===== CAD - Fusion 360 (3.5.5) =====
*.f3z
__cache__/

# ===== Secrets (3.5.6) =====
*.pem
*.key
credentials.json

# ===== Additions from v0.4 (3.5.7) =====
.github/act/
.idea/
*.iml
.yarn/cache/
.yarn/install-state.gz
.pnp.*
*~
*.bak
*.orig
firmware/cubemx-scratch/

# ===== Option B vendor blob (3.5.9) =====
# STM32CubeWB is huge (~400 MB) and reproducible from one git clone.
# Treat it like node_modules: not in the repo.
firmware/third_party/cube-wb/

# CubeMX backup .ioc files (canonical .ioc lives next to them)
firmware/*.ioc_bak
firmware/**/*.ioc.bak

# CubeMX-generated Makefile (we use CMake)
firmware/Makefile
firmware/Debug/
firmware/Release/

# HAL_Driver template files - *_template.c stubs cause link errors
firmware/Core/Src/*_template.c
firmware/Drivers/

# Compile-commands DB regenerated by CMake
compile_commands.json
.cache/clangd/
